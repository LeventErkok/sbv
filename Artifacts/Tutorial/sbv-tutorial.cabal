cabal-version: 3.0
name: sbv-tutorial
version: 0.1.0.0
synopsis: Executable companion to A Tutorial on SBV
description: Checked examples, exercises, and solver diagnostics for the tutorial.
category: Development
maintainer: Tutorial authors
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with: GHC ==9.14.1
extra-source-files:
  README.md
  cabal.project
  cabal.project.freeze
  Makefile
  prepare.py
  validate.py
  companion.py
  examples/adder-check.c
  sbv-tutorial.tex
  references.bib

flag strict
  description: Treat compiler warnings as errors during validation
  default: False
  manual: True

executable tutorial-examples
  main-is: TutorialExamples.hs
  hs-source-dirs: examples
  build-depends:
    base ==4.22.0.0,
    sbv ==14.10
  default-language: Haskell2010
  default-extensions:
    DataKinds
    FlexibleInstances
    OverloadedLists
    QuasiQuotes
    ScopedTypeVariables
    TemplateHaskell
    TypeApplications
  ghc-options: -Wall
  if flag(strict)
    ghc-options: -Werror
